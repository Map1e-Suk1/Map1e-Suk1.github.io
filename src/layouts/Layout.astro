---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";

import ConfigCarrier from "@components/ConfigCarrier.astro";
import SakuraEffect from "@components/misc/SakuraEffect.astro";
import { appearanceConfig, profileConfig, siteConfig } from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import "katex/dist/katex.css";
import fs from "node:fs";
import path from "node:path";
import siteBackground from "../assets/images/site-background.webp";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle } = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
// 主页 / 朋友们 / 关于我 都不显示右侧栏（分类 / 标签）
const isFriendsPage = pathsEqual(Astro.url.pathname, url("/friends/"));
const isAboutPage = pathsEqual(Astro.url.pathname, url("/about/"));
// 三类页面共用一个开关：服务端给初值，客户端在 Swup 翻页时同步
const hideSidebar = isFriendsPage || isHomePage || isAboutPage;

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
const themeColorFixed = siteConfig.themeColor.fixed;

// 自定义字体：扫描 public/fonts/script/ 下的字体文件，文件名（如 great-vibes）就是配置里的字体 key。
// family 名由文件名推导（great-vibes -> "Great Vibes"），所以往那个目录丢新字体就能直接用。
// 支持 woff2 / woff / ttf / otf；同名文件只注册一个，优先 woff2（体积最小）。
const scriptFontDir = path.join(process.cwd(), "public", "fonts", "script");
const FONT_FORMATS: Record<string, string> = { woff2: "woff2", woff: "woff", ttf: "truetype", otf: "opentype" };
const scriptFontMap = new Map<string, { file: string; format: string }>();
try {
	fs.readdirSync(scriptFontDir)
		.map((f) => ({ file: f, ext: (f.split(".").pop() || "").toLowerCase() }))
		.filter((f) => !!FONT_FORMATS[f.ext])
		.sort((a, b) => a.file.localeCompare(b.file))
		.forEach((f) => {
			const key = f.file.slice(0, -(f.ext.length + 1));
			const prev = scriptFontMap.get(key);
			if (!prev || (prev.format !== "woff2" && f.ext === "woff2")) scriptFontMap.set(key, { file: f.file, format: FONT_FORMATS[f.ext] });
		});
} catch {
	/* 目录不存在就当没有自定义字体 */
}
const scriptFonts = Array.from(scriptFontMap.keys()).sort();
const scriptFamily = (key: string) =>
	key.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
const scriptStack = (key?: string) => {
	const k = String(key || "").trim();
	return k && scriptFontMap.has(k) ? `"${scriptFamily(k)}", ${appearanceConfig.fontFamily}` : "";
};
const bioFontStack = scriptStack(appearanceConfig.bioFont);
const titleFontStack = scriptStack(appearanceConfig.titleFont);
const titleSizePx = Math.min(160, Math.max(24, Number(appearanceConfig.titleSize) || 64));
const fontBase = import.meta.env.BASE_URL.replace(/\/+$/, "");
const scriptFontCss = scriptFonts
	.map((k) => {
		const info = scriptFontMap.get(k)!;
		return `@font-face{font-family:"${scriptFamily(k)}";src:url("${fontBase}/fonts/script/${encodeURIComponent(info.file)}") format("${info.format}");font-style:normal;font-weight:400;font-display:swap;}`;
	})
	.join("");
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class={`bg-[var(--page-bg)] transition text-[14px] md:text-[16px]${appearanceConfig.background.enable ? " has-site-bg" : ""}`}
	  data-overlayscrollbars-initialize
>
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle}>
		<meta name="author" content={profileConfig.name}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description || pageTitle}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description || pageTitle}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue, themeColorFixed}}>
			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// Load the hue from local storage
			// 主题色设为固定时忽略本地保存的色相，保证全站用配置里的颜色
			const hue = themeColorFixed ? configHue : (localStorage.getItem('hue') || configHue);
			document.documentElement.style.setProperty('--hue', hue);

			// 首次进入站点：先展示背景全图，UI 稍后再出现（Swup 站内翻页不会重复触发）
			if (!window.__introPlayed) {
				window.__introPlayed = true;
				document.documentElement.classList.add('is-intro');
				window.setTimeout(() => {
					document.documentElement.classList.remove('is-intro');
					// 首屏动画放完后再挂这个标记：站内翻页时，容器外的元素（侧栏）不要重播进场动画
					document.documentElement.classList.add('intro-done');
				}, 1750);
			}

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
			'glass-card': String((appearanceConfig.glass && appearanceConfig.glass.enable !== false) ? appearanceConfig.glass.card : 100) + "%",
			'glass-panel': String((appearanceConfig.glass && appearanceConfig.glass.enable !== false) ? appearanceConfig.glass.panel : 100) + "%",
			'glass-blur': ((appearanceConfig.glass && appearanceConfig.glass.enable !== false) ? appearanceConfig.glass.blur : 0) + "px",
			'site-bg': `url("${siteBackground.src}")`,
			'site-bg-opacity': String(appearanceConfig.background.enable ? appearanceConfig.background.opacity : 0),
			'font-bio': bioFontStack || "inherit",
			'font-title': titleFontStack || "inherit",
			'title-size': `${titleSizePx}px`,
			'bio-scale': bioFontStack ? "1.6" : "1",
		}}>
						/* 首屏进场遮罩：和 html::before 一样的背景合成，完全不透明地盖住 UI，
			   等 UI 的进场动画全部结束（这时毛玻璃才真正生效）再淡出，
			   避免看到「半透明 → 毛玻璃」的跳变。 */
			#intro-veil {
				display: none;
			}
			html.is-intro #intro-veil {
				display: block;
				position: fixed;
				inset: 0;
				z-index: 500;
				pointer-events: none;
				background-color: var(--page-bg);
				animation: intro-veil-out 500ms ease-in 1150ms both;
			}
			html.is-intro #intro-veil::before {
				content: "";
				position: absolute;
				inset: 0;
				background-image: var(--site-bg);
				background-size: cover;
				background-position: center;
				background-repeat: no-repeat;
				opacity: var(--site-bg-opacity, 0.3);
			}
			@keyframes intro-veil-out {
				from { opacity: 1; }
				to { opacity: 0; }
			}
			/* 全站背景图：固定铺满屏幕，不透明度由 appearanceConfig.background.opacity 控制 */
			html::before {
				content: "";
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				background-image: var(--site-bg);
				background-size: cover;
				background-position: center;
				background-repeat: no-repeat;
				opacity: var(--site-bg-opacity, 0.3);
			}
			/* 开了全站背景图时，页面底色换成中性灰：
			   背景图是半透明铺在页面底色上的，页面底色带主题色相就会把整张图染成那个颜色 */
			html.has-site-bg {
				--page-bg: oklch(0.95 0 0);
			}
			html.dark.has-site-bg {
				--page-bg: oklch(0.16 0 0);
			}
		</style>

		{appearanceConfig.fontFamily && (
			<style is:global set:html={`html, body { font-family: ${appearanceConfig.fontFamily} !important; }`}></style>
		)}

		<!-- 花体字体：public/fonts/script/ 下的每个 woff2 自动注册一个 @font-face -->
		<style is:global set:html={scriptFontCss}></style>
		<!-- 花体排版：.script-bio（一句话简介）/ .script-title（主页大标题） -->
		<style is:global set:html={`
			.script-bio {
				font-family: var(--font-bio, inherit);
				font-size: calc(1rem * var(--bio-scale, 1));
				font-weight: 400;
				line-height: 1.6;
				letter-spacing: 0.01em;
			}
			@media (min-width: 1024px) {
				.script-bio { font-size: calc(1.125rem * var(--bio-scale, 1)); }
			}
			.script-title {
				font-family: var(--font-title, inherit);
				font-size: clamp(2rem, 7vw, var(--title-size, 64px));
				font-weight: 400;
				line-height: 1.15;
				letter-spacing: 0.01em;
			}
			/* 渐变裁剪的文字（bg-clip-text + text-transparent）被鼠标框选时，
			   字本身是透明的、只剩一整块选中底色，看起来像「选中就变全蓝、字没了」。
			   让被选中的字直接用主题色画出来。 */
			.bg-clip-text::selection {
				-webkit-text-fill-color: var(--primary);
				color: var(--primary);
			}
		`}></style>


		<slot name="head"></slot>

		<link
			rel="alternate"
			type="application/rss+xml"
			title={profileConfig.name}
			href={new URL(url("/rss.xml"), Astro.site ?? Astro.url)}
		/>

	</head>
	<body class=" min-h-screen transition " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner, "no-sidebar": hideSidebar}]}
		  data-overlayscrollbars-initialize
	>
		<ConfigCarrier></ConfigCarrier>
		<slot />

		<SakuraEffect />

		<!-- 首屏进场遮罩（只在第一次进入站点时出现） -->
		<div id="intro-veil" aria-hidden="true"></div>

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>

		<script>
			import { pathsEqual, url } from "../utils/url-utils";

			// 侧栏在 Swup 的替换范围之外，站内翻页时不会重新渲染，所以每次切换后手动同步一次。
			// 主页（个人介绍大卡片）和朋友们页面都不显示右侧栏。
			const homePath = url("/");
			const friendsPath = url("/friends/");
			const aboutPath = url("/about/");

			function syncSidebar() {
				const path = window.location.pathname;
				document.body.classList.toggle(
					"no-sidebar",
					pathsEqual(path, friendsPath) ||
						pathsEqual(path, homePath) ||
						pathsEqual(path, aboutPath),
				);
			}

			syncSidebar();

			// 主页大卡片「签名」下面的打字机效果。
			// 放在 Layout 里而不是组件里：站内翻页不会重新执行组件脚本，而 Layout 脚本一直挂着。
			// 当前页面没有那个元素时直接返回，所以可以放心长期挂 page:view。
			let heroTypingTimer: number | undefined;

			function startHeroTyping() {
				const el = document.getElementById("hero-typing");
				if (!el) return;
				if (heroTypingTimer) window.clearTimeout(heroTypingTimer);
				const phrases = (el.dataset.phrases || "").split("|").filter(Boolean);
				if (phrases.length === 0) return;
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
					el.textContent = phrases[0];
					return;
				}
				let phrase = 0;
				let index = 0;
				let deleting = false;
				const tick = () => {
					if (!el.isConnected) return;
					const current = phrases[phrase];
					if (!deleting) {
						index++;
						el.textContent = current.slice(0, index);
						if (index === current.length) {
							deleting = true;
							heroTypingTimer = window.setTimeout(tick, 2400);
							return;
						}
						heroTypingTimer = window.setTimeout(tick, 90);
					} else {
						index--;
						el.textContent = current.slice(0, index);
						if (index === 0) {
							deleting = false;
							phrase = (phrase + 1) % phrases.length;
							heroTypingTimer = window.setTimeout(tick, 400);
							return;
						}
						heroTypingTimer = window.setTimeout(tick, 40);
					}
				};
				tick();
			}

			startHeroTyping();

			const setupSidebar = () => {
				window.swup.hooks.on("page:view", () => {
					syncSidebar();
					startHeroTyping();
				});
			};
			if (window?.swup?.hooks) setupSidebar();
			else document.addEventListener("swup:enable", setupSidebar);
		</script>

	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@tailwind components;
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	/* 滚动收起导航栏：同样不能用 opacity，否则导航栏的毛玻璃会先消失、回滚时再「啪」地出现 */
	.navbar-hidden {
		@apply -translate-y-24 invisible
	}
}
</style>

