---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";

interface Props {
	class: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
	// 列表卡片用：左边「发布时间 / 最后更新」竖排，右边「分类 / 标签」竖排靠右，且都不带图标
	metaRight?: boolean;
}
const {
	published,
	updated,
	tags,
	category,
	hideTagsForMobile = false,
	hideUpdateDate = false,
	metaRight = false,
} = Astro.props;
const className = Astro.props.class;
---

<!-- metaRight（列表卡片）：左右各两行，纯文字不带图标，整行顶端对齐；
     否则（文章正文页）保持原来的样子：图标 + 文字排成一行。 -->
<div class:list={["flex flex-wrap text-neutral-500 dark:text-neutral-400 gap-4 gap-x-4 gap-y-2", metaRight ? "items-start" : "items-center", className]}>
    <!-- 发布时间 + 最后更新；卡片上竖排两行，文章页用 display:contents 保持同一行 -->
    <div class:list={[{ "flex flex-col items-start gap-1.5": metaRight, "contents": !metaRight }]}>
        <!-- publish date -->
        <div class:list={["flex items-center", { "gap-1.5": metaRight }]}>
            {!metaRight && (
                <div class="meta-icon">
                    <Icon name="material-symbols:calendar-today-outline-rounded" class="text-xl"></Icon>
                </div>
            )}
            {metaRight && <span class="text-50 text-sm font-medium">{i18n(I18nKey.publishedAt)}</span>}
            <span class="text-50 text-sm font-medium">{formatDateToYYYYMMDD(published)}</span>
        </div>

        <!-- update date：只要 front matter 里写了 updated 就显示；没写就不显示 -->
        {!hideUpdateDate && updated && (
            <div class="flex items-center gap-1.5">
                {!metaRight && (
                    <div class="meta-icon">
                        <Icon name="material-symbols:edit-calendar-outline-rounded" class="text-xl"></Icon>
                    </div>
                )}
                <span class="text-50 text-sm font-medium">{i18n(I18nKey.updatedAt)}</span>
                <span class="text-50 text-sm font-medium">{formatDateToYYYYMMDD(updated)}</span>
            </div>
        )}
    </div>

    <!-- 分类 + 标签；卡片上竖排两行靠右（纯文字） -->
    <div class:list={[{ "ml-auto flex flex-col items-end gap-1.5": metaRight, "flex flex-wrap items-center gap-x-4 gap-y-2": !metaRight }]}>
        <!-- categories -->
        <div class="flex items-center">
            {!metaRight && (
                <div class="meta-icon">
                    <Icon name="material-symbols:book-2-outline-rounded" class="text-xl"></Icon>
                </div>
            )}
            <div class="flex flex-row flex-nowrap items-center">
                <a href={getCategoryUrl(category)} aria-label={`View all posts in the ${category} category`}
                   class="link-lg transition text-50 text-sm font-medium
                                hover:text-[var(--primary)] dark:hover:text-[var(--primary)] whitespace-nowrap">
                    {category || i18n(I18nKey.uncategorized)}
                </a>
            </div>
        </div>

        <!-- tags -->
        <div class:list={["items-center", {"flex": !hideTagsForMobile, "hidden md:flex": hideTagsForMobile}]}>
            {!metaRight && (
                <div class="meta-icon">
                    <Icon name="material-symbols:tag-rounded" class="text-xl"></Icon>
                </div>
            )}
            <div class="flex flex-row flex-nowrap items-center">
                {/* 卡片上的标签名字用粗一点的字重（500 → 700），文章页保持原样 */}
                {(tags && tags.length > 0) && tags.map((tag, i) => (
                    <div class:list={[{"hidden": i == 0}, "mx-1.5 text-[var(--meta-divider)] text-sm"]}>/</div>
                    <a href={getTagUrl(tag)} aria-label={`View all posts with the ${tag.trim()} tag`}
                       class:list={["link-lg transition text-50 text-sm hover:text-[var(--primary)] dark:hover:text-[var(--primary)] whitespace-nowrap", metaRight ? "font-bold" : "font-medium"]}>
                        {tag.trim()}
                    </a>
                ))}
                {!(tags && tags.length > 0) && <div class="transition text-50 text-sm font-medium">{i18n(I18nKey.noTags)}</div>}
            </div>
        </div>
    </div>
</div>
