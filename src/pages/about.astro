---
import { getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import { profileConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="card-base onload-animation relative overflow-hidden px-6 py-10 lg:px-10 lg:py-12 mb-4">
        <!-- 主题色光晕 -->
        <div class="absolute -top-24 -left-20 w-72 h-72 rounded-full bg-[var(--primary)] opacity-[0.14] blur-3xl pointer-events-none transition"></div>
        <div class="absolute -bottom-28 -right-20 w-72 h-72 rounded-full bg-[var(--primary)] opacity-[0.14] blur-3xl pointer-events-none transition"></div>

        <!-- 头像 + 名字 + 签名 -->
        <div class="relative flex flex-col items-center text-center mb-8">
            <div class="relative mb-5">
                <div class="absolute -inset-3 rounded-full bg-[var(--primary)] opacity-20 blur-xl"></div>
                <div class="relative rounded-full p-[3px] bg-gradient-to-tr from-[var(--primary)] via-[oklch(0.82_0.12_var(--hue))] to-[var(--primary)]">
                    <div class="rounded-full p-1 bg-[var(--card-bg)]">
                        <div class="w-32 h-32 lg:w-36 lg:h-36 rounded-full overflow-hidden">
                            <ImageWrapper src={profileConfig.avatar || ""} alt="Profile Image of the Author"
                                          class="w-full h-full"></ImageWrapper>
                        </div>
                    </div>
                </div>
            </div>

            <h1 class="text-3xl lg:text-4xl font-bold mb-3 dark:text-neutral-50 transition">
                <span class="bg-gradient-to-r from-[var(--primary)] via-[oklch(0.72_0.16_var(--hue))] to-[oklch(0.62_0.18_var(--hue))]
                    bg-clip-text text-transparent">{profileConfig.name}</span>
            </h1>

            <div class="flex items-center gap-3 mb-6">
                <div class="h-px w-8 bg-[var(--primary)] opacity-40"></div>
                <p class="text-base lg:text-lg text-neutral-600 dark:text-neutral-300 transition">{profileConfig.bio}</p>
                <div class="h-px w-8 bg-[var(--primary)] opacity-40"></div>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-2.5">
                {profileConfig.links.map(item => (
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                       class="btn-regular rounded-lg h-10 gap-2 px-4 text-sm font-bold active:scale-95">
                        <Icon name={item.icon} class="text-[1.25rem]"></Icon>
                        {item.name}
                    </a>
                ))}
            </div>
        </div>

        <!-- 分隔：自我介绍 -->
        <div class="relative flex items-center gap-3 max-w-3xl mx-auto mb-6">
            <div class="h-px flex-1 bg-[var(--primary)] opacity-25"></div>
            <span class="text-sm text-neutral-400 dark:text-neutral-500 select-none">自我介绍</span>
            <div class="h-px flex-1 bg-[var(--primary)] opacity-25"></div>
        </div>

        <!-- 自我介绍（about.md 的内容） -->
        <div class="relative text-left max-w-3xl mx-auto">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
