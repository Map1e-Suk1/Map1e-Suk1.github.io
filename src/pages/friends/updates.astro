---
import { Icon } from "astro-icon/components";
import { url } from "@utils/url-utils";
import { getFriendsActivity } from "@utils/friend-feeds";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

const { posts, missing } = await getFriendsActivity();

// 以 / 开头的本地头像要加 base 前缀，外链保持原样（和 friends.astro 一个规矩）
const avatarUrl = (src: string) => (src.startsWith("/") ? url(src) : src);

const friendCount = new Set(posts.map((post) => post.friend)).size;

const dateText = (iso: string) => {
	if (!iso) return "";
	const time = new Date(iso);
	if (Number.isNaN(time.getTime())) return "";
	return new Intl.DateTimeFormat("zh-CN", {
		timeZone: "Asia/Shanghai",
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	}).format(time);
};

const title = "朋友们最近在写什么";
const intro = "把朋友们站点上的 RSS 汇总到这里，按发布时间从新到旧排。页面是在构建时抓取的，所以想看到最新的更新，重新发布一次博客就好。";
---

<MainGridLayout title={title} description={intro}>
    <div class="flex flex-col gap-4 w-full">
        <div class="card-base px-9 py-6">
            <div class="flex items-start justify-between gap-4 flex-wrap">
                <div class="min-w-0">
                    <div class="text-2xl font-bold text-[var(--primary)] mb-3 transition">{title}</div>
                    <div class="text-black/50 dark:text-white/50 transition leading-6">{intro}</div>
                    {posts.length > 0 && (
                        <div class="text-sm text-black/40 dark:text-white/40 mt-2 transition">
                            共 {posts.length} 条更新，来自 {friendCount} 位朋友。
                        </div>
                    )}
                </div>
                <a href={url("/friends/")}
                   class="shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-bold
                          bg-[var(--btn-regular-bg)] text-[var(--primary)] transition
                          hover:bg-[var(--btn-regular-bg-hover)] active:scale-[0.98]">
                    <Icon name="fa6-solid:angle-left" class="text-xs" />
                    回到友链
                </a>
            </div>
        </div>

        {posts.length > 0 ? (
            <div class="card-base px-6 py-2 lg:px-9 lg:py-3 transition">
                {posts.map((post) => (
                    <a href={post.link} target="_blank" rel="noopener noreferrer"
                       class="group flex items-start gap-4 py-4 border-b border-black/5 dark:border-white/10 last:border-0 transition">
                        <div
                            class="w-10 h-10 rounded-full shrink-0 mt-0.5 flex items-center justify-center text-sm font-bold bg-[var(--btn-regular-bg)] text-[var(--primary)] transition"
                            style={post.avatar
                                ? `background-image: url("${avatarUrl(post.avatar)}"); background-size: cover; background-position: center;`
                                : undefined}
                        >
                            {!post.avatar && post.friend.slice(0, 1)}
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="font-bold leading-6 text-black dark:text-white transition group-hover:text-[var(--primary)] dark:group-hover:text-[var(--primary)]">
                                {post.title}
                            </div>
                            <div class="text-xs text-black/40 dark:text-white/40 mt-1 transition">
                                {post.friend}
                                {post.date && <span class="mx-1.5">·</span>}
                                {post.date && dateText(post.date)}
                            </div>
                        </div>
                        <Icon name="fa6-solid:arrow-up-right-from-square"
                              class="text-black/15 dark:text-white/15 group-hover:text-[var(--primary)] transition shrink-0 mt-1.5" />
                    </a>
                ))}
            </div>
        ) : (
            <div class="card-base px-9 py-10 text-center transition">
                <div class="text-black/50 dark:text-white/50 leading-7">
                    这次一条都没读到……可能是朋友们的站点暂时连不上，或者构建的时候网络不太行。<br />
                    过一会儿重新发布一次博客再试试。
                </div>
            </div>
        )}

        {missing.length > 0 && (
            <div class="card-base px-6 py-5 lg:px-9 transition">
                <div class="text-sm text-black/40 dark:text-white/40 leading-6 transition">
                    下面这几位没找到 RSS（或者这次没连上），所以这里看不到他们的更新：
                    <span class="text-black/60 dark:text-white/60">
                        {missing.map((item, index) => (
                            <>
                                {index > 0 && <span class="mx-1">·</span>}
                                <a href={item.site} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--primary)] hover:underline transition">{item.name}</a>
                            </>
                        ))}
                    </span>
                </div>
                <div class="text-xs text-black/30 dark:text-white/30 mt-2 transition">
                    想让他们也出现在这里的话，可以让朋友在自己的博客里开启 RSS（一般是一个 /rss.xml 之类的地址）。
                </div>
            </div>
        )}
    </div>
</MainGridLayout>
