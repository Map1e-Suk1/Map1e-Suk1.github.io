---
import { Icon } from "astro-icon/components";
import { friendsConfig, profileConfig } from "@/config";
import { url } from "@utils/url-utils";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const { title, intro, friends } = friendsConfig;

// 以 / 开头的本地图片加上 base 前缀，外链保持原样
const avatarUrl = (src: string) => (src.startsWith("/") ? url(src) : src);

// 交换友链时对方需要填的四项信息，值直接取自站点配置，改配置这里会跟着变。
// key 必须和 friendsConfig.friends[] 里的字段名一致（对方就是照着这个填的）；
// label/icon 只是给本站访客看的。注意连续空格在 HTML 里会被 Astro 压成一个，
// 所以显示用卡片式排版，复制出去的文字用下面拼好的等宽对齐文本（存在 data-copy 里）。
const siteOrigin = import.meta.env.SITE;
const infoRows = [
	{ key: "name", label: "名字", icon: "fa6-solid:user", value: profileConfig.name },
	{ key: "url", label: "链接", icon: "fa6-solid:link", value: new URL(siteOrigin).href },
	{ key: "avatar", label: "头像图片链接", icon: "fa6-solid:image", value: new URL(url(profileConfig.avatar), siteOrigin).href },
	{ key: "description", label: "一句话简介", icon: "fa6-solid:quote-left", value: profileConfig.bio },
];
const infoText = infoRows.map(({ key, value }) => key.padEnd(12) + value).join("\n");
---

<MainGridLayout title={title} description={intro}>
    <div class="flex flex-col gap-4 w-full">
        <div class="card-base px-9 py-6">
            <div class="text-2xl font-bold text-[var(--primary)] mb-3 transition">{title}</div>
            {intro && <div class="text-black/50 dark:text-white/50 transition">{intro}</div>}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {friends.map((friend) => (
                <a href={friend.url} target="_blank" rel="noopener noreferrer"
                   class="card-base card-shadow p-4 flex items-center gap-4 group transition hover:-translate-y-0.5 active:scale-[0.99]">
                    <div
                        class="w-14 h-14 rounded-full shrink-0 flex items-center justify-center text-xl font-bold bg-[var(--btn-regular-bg)] text-[var(--primary)] transition"
                        style={friend.avatar
                            ? `background-image: url("${avatarUrl(friend.avatar)}"); background-size: cover; background-position: center;`
                            : undefined}
                    >
                        {!friend.avatar && friend.name.slice(0, 1)}
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="text-lg font-bold truncate text-black dark:text-white transition group-hover:text-[var(--primary)] dark:group-hover:text-[var(--primary)]">{friend.name}</div>
                        {friend.description && (
                            <div class="text-sm text-black/40 dark:text-white/40 line-clamp-2 transition">{friend.description}</div>
                        )}
                    </div>
                    <Icon name="fa6-solid:arrow-up-right-from-square"
                          class="text-black/20 dark:text-white/20 group-hover:text-[var(--primary)] transition shrink-0" />
                </a>
            ))}
        </div>

        <div class="card-base px-6 py-6 lg:px-9 transition">
            <div class="flex items-center gap-2.5 mb-2.5">
                <div class="w-1 h-4 rounded-md bg-[var(--primary)] transition"></div>
                <div class="text-lg font-bold text-black dark:text-white transition">想交换友链？</div>
            </div>
            <div class="text-sm text-black/50 dark:text-white/50 leading-6 transition">
                可以在 GitHub 上找我，或者发邮件到 <a class="text-[var(--primary)] hover:underline" href="mailto:Map1e-Suk1@qq.com">Map1e-Suk1@qq.com</a>。
                把下面这四项填进你站点的友链配置里就行：
            </div>

            <div
                id="friend-info-template"
                data-copy={infoText}
                class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-2.5"
            >
                {infoRows.map(({ key, label, icon, value }) => (
                    <div class="flex items-start gap-3 px-3.5 py-3 rounded-xl bg-black/[0.035] dark:bg-white/[0.06] transition">
                        <div class="w-8 h-8 rounded-lg shrink-0 flex items-center justify-center bg-[color-mix(in_srgb,var(--primary)_14%,transparent)] text-[var(--primary)] transition">
                            <Icon name={icon} class="text-[0.9rem]"></Icon>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="text-[13px] leading-5 transition">
                                <span class="font-bold text-black/70 dark:text-white/70">{label}</span>
                                <span class="ml-1.5 font-mono text-black/30 dark:text-white/30">{key}</span>
                            </div>
                            <div class="mt-0.5 text-[13px] leading-5 font-mono text-black/75 dark:text-white/75 break-all select-all transition">{value}</div>
                        </div>
                    </div>
                ))}
            </div>

            <div class="mt-3.5 flex flex-wrap items-center gap-x-3 gap-y-1.5">
                <button
                    type="button"
                    class="copy-friend-info btn-regular rounded-lg h-9 gap-2 px-4 text-sm font-bold text-[var(--primary)] active:scale-95"
                >
                    <Icon name="fa6-regular:copy" class="text-[1rem]"></Icon>
                    <span>复制这四项信息</span>
                </button>
                <span class="text-xs text-black/35 dark:text-white/35 transition">复制出来是排好版的纯文本，直接发给对方就行</span>
            </div>
        </div>
    </div>
</MainGridLayout>
